# Chapter Capture review screen (web). Names only: set the values in Vercel project settings
# (or a local .env.local that is never committed). Every variable of the first part is required
# at request time; when one is missing or invalid the app shows a "not configured" page and
# serves no data.

# Auth.js session encryption secret (generate with `npx auth secret`).
AUTH_SECRET=

# Entra app registration of the review screen ("Chapter Main" tenant).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant-specific v2.0 issuer: https://login.microsoftonline.com/<tenant id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Station API host, without the /v1 base path (https; http only for localhost).
STATION_API_URL=
# Delegated scope of the station API app registration, for example api://<station app id>/<scope name>
STATION_API_SCOPE=

# Optional links (https only). Unset or invalid: the link is not shown, and an invalid value is
# named once in the server log. The project page's "Open in the HUB" comes from the station
# (HUB_WEB_DEAL_URL_TEMPLATE in the station's settings), not from here.

# Topbar "Open the HUB", for example https://hub.hellochapter.com
HUB_APP_URL=
# Station card "HUB › Files › Capture › r1". {dealId} and {folder} are filled in, URL-encoded,
# for example https://hub.hellochapter.com/deals/{dealId}/files?folder={folder}
HUB_FILES_URL_TEMPLATE=
# Sidebar "Intake guide": the File Intake Guide.
INTAKE_GUIDE_URL=
