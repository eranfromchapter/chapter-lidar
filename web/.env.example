# Chapter Capture review screen (web). Names only: set the values in Vercel project settings
# (or a local .env.local that is never committed). Every variable is required at request time;
# when one is missing or invalid the app shows a "not configured" page and serves no data.

# Auth.js session encryption secret (generate with `npx auth secret`).
AUTH_SECRET=

# Entra app registration of the review screen ("Chapter Main" tenant).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Tenant-specific v2.0 issuer: https://login.microsoftonline.com/<tenant id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Station API host, without the /v1 base path (https; http only for localhost).
STATION_API_URL=
# Delegated scope of the station API app registration, for example api://<station app id>/<scope name>
STATION_API_SCOPE=
