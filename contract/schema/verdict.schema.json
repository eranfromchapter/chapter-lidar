{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hellochapter.com/schemas/chapter-capture/v1/verdict.schema.json",
  "title": "Verdict",
  "description": "Station result for one package: one of three outcomes, the result of every check run, findings with evidence and next actions, named limitations and a fixed statement that this is not a certification of measurements. ready: ready for the stated preliminary task, no blockers, no limitations. limited: usable with named limitations, no blockers. blocked: missing information prevents the task; at least one blocker finding. Optional fields are omitted, never null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdictId",
    "packageId",
    "captureId",
    "revision",
    "outcome",
    "task",
    "summary",
    "evaluatedAt",
    "evaluator",
    "checks",
    "findings",
    "limitations",
    "nextActions",
    "statement"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verdictId": {
      "$ref": "#/$defs/uuid"
    },
    "packageId": {
      "$ref": "#/$defs/uuid"
    },
    "captureId": {
      "$ref": "#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "task": {
      "description": "The preliminary task the outcome applies to, for example Preliminary existing-condition plans.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "description": "One or two plain sentences explaining the outcome.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evaluatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "evaluator": {
      "description": "Station component and rule set version that produced the verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "checks": {
      "description": "Result of every rule the station ran on this package.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "description": "Named limitations in plain words. Empty when the outcome is ready.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "nextActions": {
      "description": "Targeted measurements, photos, exports or recapture to request.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "statement": {
      "description": "Fixed statement carried by every verdict.",
      "const": "This verdict is an automated check of the intake package. It does not certify any property model or measurement."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/blockerFinding"
            }
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "type": "array",
            "not": {
              "contains": {
                "$ref": "#/$defs/blockerFinding"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "limited"
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "description": "Lowercase RFC 9562 UUID.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "description": "UTC timestamp, whole seconds, RFC 3339 with Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "areaKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "relativePath": {
      "description": "Path relative to the package root, forward slashes, no '.' or '..' segments.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.{1,2}(/|$))[^\\\\\\x00-\\x1f]+$"
    },
    "outcome": {
      "description": "Shown as ● Ready, ▲ Limited, ■ Blocked.",
      "enum": ["ready", "limited", "blocked"]
    },
    "ruleId": {
      "description": "Stable rule id, for example units.scale or floors.registration.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 100
    },
    "severity": {
      "description": "blocker prevents the task; limitation allows it with a named limitation; info records evidence, including passed checks.",
      "enum": ["blocker", "limitation", "info"]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "title", "status"],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/ruleId"
        },
        "title": {
          "description": "Rule name shown to people, for example Units and scale.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["passed", "failed", "not_applicable"]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "message", "nextAction"],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/ruleId"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "filePath": {
          "description": "Package file the finding is about.",
          "$ref": "#/$defs/relativePath"
        },
        "areaKey": {
          "$ref": "#/$defs/areaKey"
        },
        "measured": {
          "description": "Measured value with units, for example Distance A -0.4% vs tape.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expected": {
          "description": "Expected value or tolerance, for example within 1% or 25.4 mm.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "nextAction": {
          "description": "What to do next, or None.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "blockerFinding": {
      "type": "object",
      "properties": {
        "severity": {
          "const": "blocker"
        }
      },
      "required": ["severity"]
    }
  }
}
