{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hellochapter.com/schemas/chapter-capture/v1/walkthrough-log.schema.json",
  "title": "WalkthroughLog",
  "description": "The raw record of one AR walkthrough capture (spec F15): when it ran, the camera intrinsics, the camera pose of each recorded video frame, the floor height, and every tap the operator made, room by room, with the scale check. Written by the app as Original Exports/{areaKey}/{captureId}/walkthrough-log.json with role walkthrough_log, next to walkthrough.mp4 (role walkthrough_video). Every point and transform is in the walkthrough's own AR frame: metres, right-handed, +Y up (ARKit world frame with gravity alignment). Times are seconds since startedAt. Optional fields are omitted, never null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "visitId",
    "captureId",
    "areaKey",
    "startedAt",
    "finishedAt",
    "floorY",
    "frames",
    "rooms"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "visitId": {
      "$ref": "#/$defs/uuid"
    },
    "captureId": {
      "$ref": "#/$defs/uuid"
    },
    "areaKey": {
      "$ref": "#/$defs/areaKey"
    },
    "startedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "finishedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "video": {
      "description": "The recorded video. Omitted when nothing was recorded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height", "framesPerSecond"],
      "properties": {
        "path": {
          "description": "Package path of the video (role walkthrough_video).",
          "$ref": "#/$defs/relativePath"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "framesPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "intrinsics": {
      "description": "Camera intrinsics of the recorded frames, in pixels of the video.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fx", "fy", "cx", "cy", "width", "height"],
      "properties": {
        "fx": {
          "type": "number"
        },
        "fy": {
          "type": "number"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "floorY": {
      "description": "Height of the floor plane the corner taps lie on.",
      "type": "number"
    },
    "frames": {
      "description": "The camera pose of each recorded video frame, in time order. Empty when nothing was recorded.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "scaleCheck": {
      "description": "The tape length of one walked wall. Every length of the capture is scaled by tape / AR length.",
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "wallIndex", "tape"],
      "properties": {
        "roomId": {
          "$ref": "#/$defs/id"
        },
        "wallIndex": {
          "description": "Index of the wall in the room: wall i runs from corner i to corner i + 1.",
          "type": "integer",
          "minimum": 0
        },
        "tape": {
          "$ref": "#/$defs/length"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "description": "Lowercase RFC 9562 UUID.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "description": "UTC timestamp, whole seconds, RFC 3339 with Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "areaKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "relativePath": {
      "description": "Path relative to the package root, forward slashes, no '.' or '..' segments.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.{1,2}(/|$))[^\\\\\\x00-\\x1f]+$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "tracking": {
      "description": "ARKit tracking state when the frame or tap was taken.",
      "enum": ["normal", "limited", "not_available"]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "transform", "tracking"],
      "properties": {
        "t": {
          "description": "Seconds since startedAt.",
          "type": "number",
          "minimum": 0
        },
        "transform": {
          "description": "Camera-to-world transform, 16 numbers column-major (four columns of four, like simd_float4x4).",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "tracking": {
          "$ref": "#/$defs/tracking"
        }
      }
    },
    "tap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "t", "tracking"],
      "properties": {
        "p": {
          "description": "The tapped point.",
          "$ref": "#/$defs/vec3"
        },
        "t": {
          "description": "Seconds since startedAt.",
          "type": "number",
          "minimum": 0
        },
        "tracking": {
          "$ref": "#/$defs/tracking"
        }
      }
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueMm", "enteredUnit", "enteredText"],
      "properties": {
        "valueMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200000
        },
        "enteredUnit": {
          "enum": ["mm", "cm", "m", "in", "ft", "ft_in"]
        },
        "enteredText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "method", "ceiling", "openings"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "enum": [
            "living_room",
            "dining_room",
            "kitchen",
            "bedroom",
            "bathroom",
            "closet",
            "hallway",
            "laundry",
            "office",
            "utility",
            "other"
          ]
        },
        "method": {
          "description": "corners: one tap per floor corner in order, then the closing tap on the first corner; walls: two or more floor taps along the base of each wall in order (corners are the intersections of consecutive wall lines).",
          "enum": ["corners", "walls"]
        },
        "corners": {
          "description": "method corners: the corner taps in walking order (at least three). Present exactly with method corners.",
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/tap"
          }
        },
        "closingTap": {
          "description": "method corners: the tap back on the first corner that closed the room. Omitted when the operator closed the room without it (no drift measure).",
          "$ref": "#/$defs/tap"
        },
        "walls": {
          "description": "method walls: per wall, in walking order, two or more taps along its base. Present exactly with method walls.",
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/tap"
            }
          }
        },
        "ceiling": {
          "description": "Taps where a wall meets the ceiling. Empty: the room uses the floor's last ceiling height, or the default.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/tap"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          }
        }
      },
      "if": {
        "properties": {
          "method": {
            "const": "corners"
          }
        }
      },
      "then": {
        "properties": {
          "corners": true
        },
        "required": ["corners"],
        "not": {
          "properties": {
            "walls": true
          },
          "required": ["walls"]
        }
      },
      "else": {
        "required": ["walls"],
        "allOf": [
          {
            "not": {
              "properties": {
                "corners": true
              },
              "required": ["corners"]
            }
          },
          {
            "not": {
              "properties": {
                "closingTap": true
              },
              "required": ["closingTap"]
            }
          }
        ],
        "properties": {
          "walls": true
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "wallIndex", "leftJamb", "rightJamb"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["door", "window", "opening"]
        },
        "wallIndex": {
          "description": "The wall of the room the opening is in: wall i runs from corner i to corner i + 1.",
          "type": "integer",
          "minimum": 0
        },
        "leftJamb": {
          "description": "One jamb: at the floor for a door or opening, on the wall plane at any height for a window.",
          "$ref": "#/$defs/tap"
        },
        "rightJamb": {
          "$ref": "#/$defs/tap"
        },
        "head": {
          "description": "The top of the opening, on the wall plane. Omitted: the default height.",
          "$ref": "#/$defs/tap"
        },
        "sill": {
          "description": "Windows: the sill, on the wall plane. Omitted: the default sill.",
          "$ref": "#/$defs/tap"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "window"
          }
        }
      },
      "else": {
        "not": {
          "properties": {
            "sill": true
          },
          "required": ["sill"]
        }
      }
    }
  }
}
