{
  "name": "@chapter/station-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Chapter Capture station worker: claims checks and publish jobs (SKIP LOCKED), runs the acceptance checks, stores verdicts and publishes them to the HUB.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:deps": "npm run build --workspace @chapter/station-checks && npm run build --workspace @chapter/station-hub",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:deps",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "pretest:e2e": "npm run build:deps",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"test/e2e/**/*.e2e.ts\""
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@azure/storage-blob": "12.34.0",
    "@chapter/capture-contract": "1.1.0",
    "@chapter/station-checks": "1.0.0",
    "@chapter/station-hub": "1.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
