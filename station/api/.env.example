# Station API settings for the local stack (docker-compose.yml passes this file to the API).
# No secrets here. In Azure Container Apps the secret values (HUB_SERVICE_CREDENTIAL, storage
# credentials) are Key Vault references (secretRef) and the rest are plain settings.
# See src/core/config.ts for every variable and its default.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Postgres sign-in. Locally: a connection string to the compose Postgres (trust auth, no
# password). In Azure: DB_AUTH=entra with PGHOST, PGPORT, PGDATABASE, PGUSER (the managed
# identity's Postgres role), PGSSLMODE=require and, for a user-assigned identity,
# AZURE_CLIENT_ID; no DATABASE_URL or PGPASSWORD.
DB_AUTH=url
DATABASE_URL=postgres://station@postgres:5432/station
MIGRATE_ON_START=true

# Microsoft Entra ID. Placeholders for local use: set the "Chapter Main" tenant id and the
# station app registration's audience (client id and/or App ID URI, comma-separated) to call
# protected routes with real tokens. Issuer and JWKS URL default from the tenant id.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://chapter-capture-station-local
# LOCAL STACK ONLY: tokens come from the dev-idp service (station/dev-idp), never Entra.
# In Azure leave both unset so they default to the tenant's Entra issuer and keys.
ENTRA_ISSUER=http://localhost:8090/
ENTRA_JWKS_URL=http://localhost:8090/keys

# HUB lookup: fake (built-in test data) or live. Live also needs HUB_BASE_URL (https in
# production) and HUB_SERVICE_CREDENTIAL (secret, Key Vault reference in Azure).
HUB_MODE=fake

# Blob storage: Azurite in the compose network. This is Azurite's published, well-known
# development account (devstoreaccount1), not a real credential.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
STORAGE_ORIGINALS_CONTAINER=originals
# The station's spatial reports, written by the worker (links from GET /packages/{id}/spatial-report).
STORAGE_REPORTS_CONTAINER=reports
# Blob endpoint as reached from the host (upload targets handed to clients).
STORAGE_PUBLIC_BLOB_ENDPOINT=http://localhost:10000/devstoreaccount1

# Web pages a package links to (PackageLinks; optional, links are omitted while unset).
# REVIEW_BASE_URL is the review screen (the same value as the worker's); HUB_WEB_DEAL_URL_TEMPLATE
# is the HUB page of a deal, with {dealId}. https unless the host is localhost.
REVIEW_BASE_URL=http://localhost:3000
# HUB_WEB_DEAL_URL_TEMPLATE=https://hub.example/deals/{dealId}
